      </button>
    </div>
  </div>

  <!-- Esportiva -->
  <div class="panel">
    <div class="panel-visual sport-bg">
      <img src="https://res.cloudinary.com/dekoucycr/image/upload/v1785126178/o4Do8PdWlFYH3xVbMkI3EK_1785125196524_na1fn_L2hvbWUvdWJ1bnR1L21hc3NhZ2VtL2VzcG9ydGl2YV92M18wNQ_dzp0b3.webp" alt="Massagem esportiva, pressão na panturrilha">
    </div>
