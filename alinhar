      <div class="price-block">
        <div class="price-row"><span class="price-label">Estúdio</span><span class="price-value">R$ 170</span></div>
        <div class="price-row"><span class="price-label">Domicílio</span><span class="price-value">R$ 150 + deslocamento</span></div>
      </div>
      <button class="btn-agendar" onclick="openModal('relax')">
