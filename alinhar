<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Estúdio de Massagem Terapêutica, Stiep, Salvador</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Work+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --sand:#EFE9DC;
    --sand-deep:#E4DCC9;
    --ink:#1E2B27;
    --teal:#2C4842;
    --teal-deep:#1B302C;
    --clay:#A6573C;
    --clay-soft:#C97D5D;
    --gold:#B8935A;
    --white:#FBFAF6;
    --line:rgba(30,43,39,0.14);
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--sand);
    color:var(--ink);
    font-family:'Work Sans', sans-serif;
    font-weight:400;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  @media (prefers-reduced-motion: reduce){
    *{animation-duration:0.01ms !important; animation-iteration-count:1 !important; transition-duration:0.01ms !important;}
  }
  h1,h2,h3{
    font-family:'Fraunces', serif;
    font-weight:500;
    letter-spacing:-0.01em;
    line-height:1.08;
  }
  .eyebrow{
    font-family:'Work Sans', sans-serif;
    font-size:0.72rem;
    letter-spacing:0.22em;
    text-transform:uppercase;
    font-weight:600;
    color:var(--gold);
  }
  a{color:inherit; text-decoration:none;}
  button{font-family:inherit; cursor:pointer; border:none;}

  /* ---------- HERO ---------- */
  .hero{
    position:relative;
    min-height:100vh;
    background:linear-gradient(175deg, var(--teal-deep) 0%, var(--teal) 62%, #3A5A52 100%);
    color:var(--white);
    display:flex;
    align-items:center;
    justify-content:center;
    padding:6rem 1.5rem 4rem;
    overflow:hidden;
  }
  .hero-knot{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    opacity:0.55;
  }
  .knot-path{
    fill:none;
    stroke:var(--gold);
    stroke-width:1.4;
    stroke-linecap:round;
    stroke-dasharray:1400;
    stroke-dashoffset:0;
    opacity:0.9;
    animation:untieOut 2.8s ease-in-out forwards;
  }
  .smooth-path{
    fill:none;
    stroke:rgba(251,250,246,0.35);
    stroke-width:1.4;
    stroke-linecap:round;
    stroke-dasharray:1400;
    stroke-dashoffset:1400;
    animation:untieIn 2.8s ease-in-out forwards;
  }
  @keyframes untieOut{
    0%{opacity:0.95;}
    60%{opacity:0.5;}
    100%{opacity:0;}
  }
  @keyframes untieIn{
    0%{stroke-dashoffset:1400;}
    100%{stroke-dashoffset:0;}
  }
  .hero-inner{
    position:relative;
    z-index:2;
    max-width:760px;
    text-align:center;
  }
  .hero-inner .eyebrow{color:var(--gold); display:block; margin-bottom:1.4rem;}
  .hero h1{
    font-size:clamp(2.2rem, 5.4vw, 3.9rem);
    font-weight:500;
  }
  .hero h1 em{
    font-style:italic;
    font-weight:400;
    color:#E9C892;
  }
  .hero p.lead{
    margin-top:1.6rem;
    font-size:1.08rem;
    line-height:1.65;
    color:rgba(251,250,246,0.82);
    max-width:560px;
    margin-left:auto;
    margin-right:auto;
  }
  .trust-row{
    margin-top:2.8rem;
    display:flex;
    gap:2rem;
    justify-content:center;
    flex-wrap:wrap;
  }
  .trust-item{
    display:flex;
    align-items:center;
    gap:0.55rem;
    font-size:0.82rem;
    letter-spacing:0.03em;
    color:rgba(251,250,246,0.78);
  }
  .trust-item svg{width:17px; height:17px; flex-shrink:0;}

  /* ---------- SECTION HEADER ---------- */
  .section-intro{
    max-width:640px;
    margin:0 auto;
    text-align:center;
    padding:5rem 1.5rem 2.5rem;
  }
  .section-intro .eyebrow{display:block; margin-bottom:1rem;}
  .section-intro h2{
    font-size:clamp(1.7rem, 3.4vw, 2.3rem);
    color:var(--teal-deep);
  }
  .section-intro p{
    margin-top:1rem;
    font-size:0.98rem;
    color:rgba(30,43,39,0.68);
    line-height:1.6;
  }

  /* ---------- PANELS ---------- */
  .panels{
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    max-width:1180px;
    margin:0 auto;
    padding:0 1.5rem 6rem;
    gap:1.6rem;
  }
  @media (max-width:880px){
    .panels{grid-template-columns:1fr; max-width:480px;}
  }
  .panel{
    background:var(--white);
    border:1px solid var(--line);
    border-radius:2px;
    overflow:hidden;
    display:flex;
    flex-direction:column;
    transition:transform 0.35s ease, box-shadow 0.35s ease;
  }
  .panel:hover{
    transform:translateY(-4px);
    box-shadow:0 18px 40px -20px rgba(27,48,44,0.35);
  }
  .panel-visual{
    position:relative;
    aspect-ratio:4/5;
    display:flex;
    align-items:center;
    justify-content:center;
    overflow:hidden;
  }
  .panel-visual img{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
  }
  .panel-visual .fallback{
    position:absolute;
    inset:0;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    gap:0.6rem;
    color:rgba(251,250,246,0.9);
    text-align:center;
    padding:1rem;
  }
  .fallback svg{width:38px; height:38px; opacity:0.85;}
  .fallback span{font-size:0.68rem; letter-spacing:0.08em; text-transform:uppercase; opacity:0.8;}
  .relax-bg{background:linear-gradient(150deg,#33544D,#547C6F);}
  .sport-bg{background:linear-gradient(150deg,#7A3C2A,#A6573C);}
  .thai-bg{background:linear-gradient(150deg,#5B4426,#B8935A);}

  .panel-body{
    padding:1.6rem 1.6rem 1.8rem;
    display:flex;
    flex-direction:column;
    flex:1;
  }
  .panel-body .eyebrow{margin-bottom:0.5rem;}
  .panel-body h3{
    font-size:1.32rem;
    color:var(--teal-deep);
  }
  .panel-body p{
    margin-top:0.65rem;
    font-size:0.9rem;
    line-height:1.55;
    color:rgba(30,43,39,0.65);
    flex:1;
  }
  .price-block{
    margin-top:1.1rem;
    padding-top:1.1rem;
    border-top:1px solid var(--line);
    display:flex;
    flex-direction:column;
    gap:0.35rem;
  }
  .price-row{
    display:flex;
    justify-content:space-between;
    align-items:baseline;
    gap:0.6rem;
    font-size:0.86rem;
  }
  .price-row .price-label{
    color:rgba(30,43,39,0.6);
  }
  .price-row .price-value{
    font-family:'Fraunces', serif;
    font-weight:500;
    color:var(--teal-deep);
    white-space:nowrap;
  }
  .btn-agendar{
    margin-top:1.4rem;
    background:var(--teal-deep);
    color:var(--white);
    padding:0.85rem 1.2rem;
    font-size:0.86rem;
    letter-spacing:0.04em;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:0.5rem;
    transition:background 0.25s ease;
  }
  .btn-agendar:hover{background:var(--clay);}
  .btn-agendar svg{width:16px; height:16px;}

  /* ---------- PLANO TERAPÊUTICO ---------- */
  .plan-section{
    max-width:1180px;
    margin:0 auto;
    padding:0 1.5rem 5rem;
  }
  .plan-card{
    background:linear-gradient(120deg, var(--teal-deep), var(--teal) 70%);
    color:var(--white);
    border-radius:2px;
    padding:2.6rem 2rem;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:2rem;
    flex-wrap:wrap;
    text-align:left;
  }
  .plan-card .plan-text .eyebrow{color:var(--gold); display:block; margin-bottom:0.6rem;}
  .plan-card h3{
    font-size:1.6rem;
    margin-bottom:0.5rem;
  }
  .plan-card p{
    font-size:0.92rem;
    color:rgba(251,250,246,0.78);
    max-width:420px;
    line-height:1.55;
  }
  .plan-price{
    text-align:center;
    flex-shrink:0;
  }
  .plan-price .value{
    font-family:'Fraunces', serif;
    font-weight:500;
    font-size:2.4rem;
    line-height:1;
  }
  .plan-price .value sup{
    font-size:1.1rem;
    vertical-align:0.6em;
  }
  .plan-price .caption{
    font-size:0.75rem;
    letter-spacing:0.06em;
    text-transform:uppercase;
    color:rgba(251,250,246,0.65);
    margin-top:0.4rem;
  }
  .plan-price a{
    margin-top:1.1rem;
    display:inline-flex;
    align-items:center;
    gap:0.5rem;
    background:var(--clay);
    color:var(--white);
    padding:0.8rem 1.3rem;
    font-size:0.85rem;
    letter-spacing:0.03em;
    transition:background 0.25s ease;
  }
  .plan-price a:hover{background:#8F4A32;}
  .plan-price a svg{width:15px; height:15px;}
  @media (max-width:640px){
    .plan-card{flex-direction:column; text-align:center; padding:2.4rem 1.6rem;}
    .plan-card p{max-width:none;}
  }

  /* ---------- TRUST / ETHICS STRIP ---------- */
  .ethics{
    background:var(--sand-deep);
    border-top:1px solid var(--line);
    border-bottom:1px solid var(--line);
  }
  .ethics-inner{
    max-width:1000px;
    margin:0 auto;
    padding:3.4rem 1.5rem;
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:2rem;
    text-align:center;
  }
  @media (max-width:760px){ .ethics-inner{grid-template-columns:1fr; gap:2.2rem;} }
  .ethics-item svg{width:26px; height:26px; color:var(--clay); margin-bottom:0.8rem;}
  .ethics-item h4{
    font-family:'Fraunces', serif;
    font-weight:500;
    font-size:1.02rem;
    color:var(--teal-deep);
    margin-bottom:0.4rem;
  }
  .ethics-item p{
    font-size:0.85rem;
    line-height:1.55;
    color:rgba(30,43,39,0.62);
  }

  /* ---------- FOOTER ---------- */
  footer{
    padding:3.5rem 1.5rem 2.5rem;
    text-align:center;
  }
  footer .fw-name{
    font-family:'Fraunces', serif;
    font-size:1.2rem;
    color:var(--teal-deep);
    margin-bottom:0.5rem;
  }
  footer p{
    font-size:0.85rem;
    color:rgba(30,43,39,0.6);
    line-height:1.6;
  }
  footer .wpp-link{
    color:var(--clay);
    font-weight:500;
  }

  /* ---------- MODAL ---------- */
  .modal-overlay{
    position:fixed;
    inset:0;
    background:rgba(27,32,30,0.72);
    backdrop-filter:blur(3px);
    display:none;
    align-items:center;
    justify-content:center;
    padding:1.5rem;
    z-index:100;
  }
  .modal-overlay.open{display:flex;}
  .modal-card{
    background:var(--white);
    max-width:620px;
    width:100%;
    max-height:90vh;
    overflow-y:auto;
    border-radius:2px;
    position:relative;
    animation:modalIn 0.32s ease;
  }
  @keyframes modalIn{
    from{opacity:0; transform:translateY(14px);}
    to{opacity:1; transform:translateY(0);}
  }
  .modal-close{
    position:absolute;
    top:0.85rem;
    right:0.85rem;
    background:var(--white);
    color:var(--teal-deep);
    width:38px;
    height:38px;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    z-index:6;
    box-shadow:0 4px 14px rgba(0,0,0,0.28);
    transition:background 0.2s ease, transform 0.2s ease;
  }
  .modal-close:hover{background:var(--clay); color:var(--white); transform:scale(1.06);}
  .modal-close svg{width:17px; height:17px;}
  .modal-gallery{
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:2px;
  }
  .modal-gallery .thumb{
    aspect-ratio:1/1;
    position:relative;
    overflow:hidden;
  }
  .modal-gallery .thumb img{
    width:100%; height:100%; object-fit:cover; display:block;
  }
  .modal-gallery .thumb .fallback{position:absolute; inset:0;}
  .modal-gallery .thumb .fallback svg{width:24px; height:24px;}
  .modal-body{
    padding:1.9rem 2rem 2.2rem;
  }
  .modal-body .eyebrow{margin-bottom:0.5rem;}
  .modal-body h3{
    font-size:1.5rem;
    color:var(--teal-deep);
    margin-bottom:0.9rem;
  }
  .modal-body .info-row{
    display:flex;
    gap:0.7rem;
    align-items:flex-start;
    margin-bottom:0.85rem;
  }
  .modal-body .info-row svg{
    width:17px; height:17px; flex-shrink:0; margin-top:2px; color:var(--clay);
  }
  .modal-body .info-row p{
    font-size:0.92rem;
    line-height:1.55;
    color:rgba(30,43,39,0.72);
  }
  .modal-body .btn-wpp{
    margin-top:1.4rem;
    width:100%;
    background:var(--clay);
    color:var(--white);
    padding:0.95rem;
    font-size:0.92rem;
    letter-spacing:0.03em;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:0.55rem;
    transition:background 0.25s ease;
  }
  .modal-body .btn-wpp:hover{background:#8F4A32;}
  .modal-body .btn-wpp svg{width:18px; height:18px;}
</style>
</head>
<body>

<!-- ============ HERO ============ -->
<section class="hero">
  <svg class="hero-knot" viewBox="0 0 800 800" preserveAspectRatio="xMidYMid slice">
    <path class="knot-path" d="M120,420 C220,340 260,500 360,420 C420,370 380,300 440,320 C520,346 460,460 540,470 C610,478 600,380 660,400 C700,414 690,470 650,480 C560,502 560,380 480,400 C400,420 440,500 360,500 C260,500 260,360 180,400 C140,420 130,460 120,420 Z" />
