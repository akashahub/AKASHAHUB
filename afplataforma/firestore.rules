rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAfMentor() {
      return request.auth != null && (
        request.auth.uid == "1GO7dRdFUFg2NwYwzOwjvtWfpAS2"
        || request.auth.token.email in [
          "yanfili.simon@gmail.com",
          "plmacramo@gmail.com",
          "sendatantrica@gmail.com",
          "opatricksimon@gmail.com"
        ]
      );
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function hasAfAccess(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && exists(/databases/$(database)/documents/afAccess/$(uid))
        && get(/databases/$(database)/documents/afAccess/$(uid)).data.approved == true
        && get(/databases/$(database)/documents/afAccess/$(uid)).data.active == true;
    }
    function isMembersAdmin() {
      return request.auth != null && (
        request.auth.token.email == "yanfili.simon@gmail.com"
        || request.auth.uid == "1GO7dRdFUFg2NwYwzOwjvtWfpAS2"
        || (
          request.auth.token.email != null
          && exists(/databases/$(database)/documents/membersAdmins/$(request.auth.token.email))
          && get(/databases/$(database)/documents/membersAdmins/$(request.auth.token.email)).data.active == true
        )
        || (
          request.auth.token.email != null
          && exists(/databases/$(database)/documents/afMentorNotes/membersPainel)
          && get(/databases/$(database)/documents/afMentorNotes/membersPainel).data.admins is list
          && request.auth.token.email in get(/databases/$(database)/documents/afMentorNotes/membersPainel).data.admins
        )
        || (
          exists(/databases/$(database)/documents/afAccess/$(request.auth.uid))
          && get(/databases/$(database)/documents/afAccess/$(request.auth.uid)).data.membersGrant.admin == true
        )
      );
    }
    function ownEntitlement() {
      return get(/databases/$(database)/documents/entitlements/$(request.auth.token.email)).data;
    }
    function hasEntitlement() {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/entitlements/$(request.auth.token.email));
    }

    // CONTEXTO COMPARTILHADO DA BIBLIOTECA DE PROMPTS
    // Titular AF aprovado e equipe AF podem ler ou editar o contexto.
    function validProjectContextMap(ctx) {
      return ctx is map
        && ctx.keys().hasOnly([
          "NOME_DO_CLIENTE_OU_EMPRESA", "SEGMENTO_E_MODELO_DE_NEGOCIO",
          "PAIS_CIDADE_E_MERCADO", "ESTAGIO_ATUAL_E_HISTORICO",
          "OBJETIVO_PRINCIPAL_E_RESULTADO_ESPERADO", "PROBLEMA_OU_OPORTUNIDADE",
          "PUBLICO_E_CLIENTE_IDEAL", "OFERTA_PRODUTO_SERVICO",
          "DADOS_E_INDICADORES_DISPONIVEIS", "RECURSOS_ORCAMENTO_E_RESTRICOES",
          "PRAZO_E_PRIORIDADE", "ATIVOS_FERRAMENTAS_E_PROCESSOS_EXISTENTES",
          "DECISOES_JA_TOMADAS_E_PREFERENCIAS", "FONTES_DOCUMENTOS_E_REFERENCIAS_AUTORIZADAS",
          "FORMATO_DO_ENTREGAVEL", "RESPONSAVEL_PELA_VALIDACAO"
        ])
        && (!("NOME_DO_CLIENTE_OU_EMPRESA" in ctx) || (ctx.NOME_DO_CLIENTE_OU_EMPRESA is string && ctx.NOME_DO_CLIENTE_OU_EMPRESA.size() <= 5000))
        && (!("SEGMENTO_E_MODELO_DE_NEGOCIO" in ctx) || (ctx.SEGMENTO_E_MODELO_DE_NEGOCIO is string && ctx.SEGMENTO_E_MODELO_DE_NEGOCIO.size() <= 5000))
        && (!("PAIS_CIDADE_E_MERCADO" in ctx) || (ctx.PAIS_CIDADE_E_MERCADO is string && ctx.PAIS_CIDADE_E_MERCADO.size() <= 5000))
        && (!("ESTAGIO_ATUAL_E_HISTORICO" in ctx) || (ctx.ESTAGIO_ATUAL_E_HISTORICO is string && ctx.ESTAGIO_ATUAL_E_HISTORICO.size() <= 5000))
        && (!("OBJETIVO_PRINCIPAL_E_RESULTADO_ESPERADO" in ctx) || (ctx.OBJETIVO_PRINCIPAL_E_RESULTADO_ESPERADO is string && ctx.OBJETIVO_PRINCIPAL_E_RESULTADO_ESPERADO.size() <= 5000))
        && (!("PROBLEMA_OU_OPORTUNIDADE" in ctx) || (ctx.PROBLEMA_OU_OPORTUNIDADE is string && ctx.PROBLEMA_OU_OPORTUNIDADE.size() <= 5000))
        && (!("PUBLICO_E_CLIENTE_IDEAL" in ctx) || (ctx.PUBLICO_E_CLIENTE_IDEAL is string && ctx.PUBLICO_E_CLIENTE_IDEAL.size() <= 5000))
        && (!("OFERTA_PRODUTO_SERVICO" in ctx) || (ctx.OFERTA_PRODUTO_SERVICO is string && ctx.OFERTA_PRODUTO_SERVICO.size() <= 5000))
        && (!("DADOS_E_INDICADORES_DISPONIVEIS" in ctx) || (ctx.DADOS_E_INDICADORES_DISPONIVEIS is string && ctx.DADOS_E_INDICADORES_DISPONIVEIS.size() <= 5000))
        && (!("RECURSOS_ORCAMENTO_E_RESTRICOES" in ctx) || (ctx.RECURSOS_ORCAMENTO_E_RESTRICOES is string && ctx.RECURSOS_ORCAMENTO_E_RESTRICOES.size() <= 5000))
        && (!("PRAZO_E_PRIORIDADE" in ctx) || (ctx.PRAZO_E_PRIORIDADE is string && ctx.PRAZO_E_PRIORIDADE.size() <= 5000))
        && (!("ATIVOS_FERRAMENTAS_E_PROCESSOS_EXISTENTES" in ctx) || (ctx.ATIVOS_FERRAMENTAS_E_PROCESSOS_EXISTENTES is string && ctx.ATIVOS_FERRAMENTAS_E_PROCESSOS_EXISTENTES.size() <= 5000))
        && (!("DECISOES_JA_TOMADAS_E_PREFERENCIAS" in ctx) || (ctx.DECISOES_JA_TOMADAS_E_PREFERENCIAS is string && ctx.DECISOES_JA_TOMADAS_E_PREFERENCIAS.size() <= 5000))
        && (!("FONTES_DOCUMENTOS_E_REFERENCIAS_AUTORIZADAS" in ctx) || (ctx.FONTES_DOCUMENTOS_E_REFERENCIAS_AUTORIZADAS is string && ctx.FONTES_DOCUMENTOS_E_REFERENCIAS_AUTORIZADAS.size() <= 5000))
        && (!("FORMATO_DO_ENTREGAVEL" in ctx) || (ctx.FORMATO_DO_ENTREGAVEL is string && ctx.FORMATO_DO_ENTREGAVEL.size() <= 5000))
        && (!("RESPONSAVEL_PELA_VALIDACAO" in ctx) || (ctx.RESPONSAVEL_PELA_VALIDACAO is string && ctx.RESPONSAVEL_PELA_VALIDACAO.size() <= 5000));
    }
    function canAccessProjectContext(uid) {
      return request.auth != null && (isAfMentor() || (request.auth.uid == uid && hasAfAccess(uid)));
    }

    // ============================================
    // LEGACY VAULT — COFRE DE LEGADO
    // Links compartilhados das bibliotecas do Drive
    // ============================================
    match /legacyVault/{documentId} {
      allow read: if request.auth != null;
      allow create, update: if isAfMentor()
        && request.resource.data.phaseLinks is map
        && request.resource.data.phaseLinks.keys().hasAll(["1", "2", "3", "4", "5"])
        && request.resource.data.phaseLinks["1"] is string
        && request.resource.data.phaseLinks["2"] is string
        && request.resource.data.phaseLinks["3"] is string
        && request.resource.data.phaseLinks["4"] is string
        && request.resource.data.phaseLinks["5"] is string;
      allow delete: if false;
    }
    match /entitlements/{email} {
      allow read: if request.auth != null && (request.auth.token.email == email || isMembersAdmin());
      allow create, update: if isMembersAdmin()
        && request.resource.data.areas is list
        && request.resource.data.cursos is list
        && request.resource.data.livros is list
        && request.resource.data.audios is list
        && request.resource.data.keys().hasAll(["areas", "cursos", "livros", "audios", "source", "grantedBy"]);
      allow delete: if isMembersAdmin();
    }
    match /membersAdmins/{email} {
      allow read: if request.auth != null && (request.auth.token.email == email || isMembersAdmin());
      allow create, update: if isMembersAdmin() && request.resource.data.active is bool && email != "yanfili.simon@gmail.com";
      allow delete: if isMembersAdmin() && email != "yanfili.simon@gmail.com" && email != request.auth.token.email;
    }
    match /aulas/{id} {
      allow read: if isMembersAdmin() || (hasEntitlement() && (resource.data.area in ownEntitlement().areas || resource.data.cursoKey in ownEntitlement().cursos));
      allow create, update: if isMembersAdmin() && request.resource.data.videoId is string && request.resource.data.videoId.size() < 80 && request.resource.data.area is string && request.resource.data.cursoKey is string;
      allow delete: if isMembersAdmin();
    }
    match /membrosAcessos/{id} {
      allow read: if request.auth != null && (request.auth.token.email == id || request.auth.token.email == "yanfili.simon@gmail.com" || request.auth.uid == "1GO7dRdFUFg2NwYwzOwjvtWfpAS2" || (id == "_config" && request.auth.token.email != null && exists(/databases/$(database)/documents/membrosAcessos/$(request.auth.token.email)) && "amon" in get(/databases/$(database)/documents/membrosAcessos/$(request.auth.token.email)).data.areas));
      allow write: if isMembersAdmin();
    }
    match /membrosGestao/{id} {
      allow read: if isMembersAdmin() || (id == "conteudo" && request.auth != null);
      allow create, update, delete: if isMembersAdmin();
    }
    match /users/{uid} {
      allow read, write: if request.auth.uid == uid;
      allow read: if isAfMentor();
    }
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == "1GO7dRdFUFg2NwYwzOwjvtWfpAS2";
    }
    match /blog_posts/{post} {
      allow read: if true;
      allow write: if request.auth.uid == "1GO7dRdFUFg2NwYwzOwjvtWfpAS2";
    }
    match /posts_alinhamento_financeiro/{postId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == "1GO7dRdFUFg2NwYwzOwjvtWfpAS2";
      match /comentarios/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.autorUid == request.auth.uid;
        allow delete: if request.auth != null && (request.auth.uid == resource.data.autorUid || request.auth.uid == "1GO7dRdFUFg2NwYwzOwjvtWfpAS2");
      }
    }
    match /posts_tecnologia_da_alma/{postId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == "1GO7dRdFUFg2NwYwzOwjvtWfpAS2";
      match /comentarios/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.autorUid == request.auth.uid;
        allow delete: if request.auth != null && (request.auth.uid == resource.data.autorUid || request.auth.uid == "1GO7dRdFUFg2NwYwzOwjvtWfpAS2");
      }
    }
    match /posts_arquitetura_de_essencia/{postId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == "1GO7dRdFUFg2NwYwzOwjvtWfpAS2";
      match /comentarios/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.autorUid == request.auth.uid;
        allow delete: if request.auth != null && (request.auth.uid == resource.data.autorUid || request.auth.uid == "1GO7dRdFUFg2NwYwzOwjvtWfpAS2");
      }
    }
    match /mentoria_respostas/{uid}/dados/{doc} {
      allow read, write: if request.auth.uid == uid;
      allow read: if isAfMentor();
    }
    match /leituras/{uid} {
      allow read, write: if request.auth.uid == uid;
      allow read: if isAfMentor();
    }
    match /mentorias/{uid}/{rest=**} {
      allow read, write: if request.auth.uid == uid;
      allow read: if isAfMentor();
    }
    match /apostilas/{uid}/respostas/{doc} {
      allow read, write: if request.auth.uid == uid;
      allow read: if isAfMentor();
    }
    match /calls/{roomId} {
      allow read, write: if true;
      match /callerCandidates/{c} { allow read, write: if true; }
      match /calleeCandidates/{c} { allow read, write: if true; }
    }
    match /presence/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == uid;
    }
    match /rooms/global/messages/{msgId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
      allow delete: if isAfMentor();
    }
    match /rooms/topics/{roomId}/messages/{msgId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
      allow delete: if isAfMentor();
    }
    match /rooms/topics/{roomId}/users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == uid;
    }
    match /matchQueue/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == uid;
    }
    match /privateRooms/{roomId} {
      allow read, write: if request.auth != null && roomId.matches('.*' + request.auth.uid + '.*');
      match /messages/{msgId} {
        allow read: if request.auth != null && roomId.matches('.*' + request.auth.uid + '.*');
        allow create: if request.auth != null && roomId.matches('.*' + request.auth.uid + '.*') && request.resource.data.uid == request.auth.uid && request.resource.data.text.size() <= 1000;
      }
    }
    match /salas_live/{salaId}/participantes/{peerId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth.uid == peerId;
    }
    match /salas_live/{salaId}/sinais/{sinalId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.para || request.auth.uid == resource.data.de);
      allow create: if request.auth != null && request.resource.data.de == request.auth.uid;
      allow delete: if request.auth != null && (request.auth.uid == resource.data.para || request.auth.uid == resource.data.de);
    }
    match /afAccess/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAfMentor());
      allow create, update: if isAfMentor();
      allow delete: if false;
    }
    match /afAccessRequests/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAfMentor());
      allow create: if isSignedIn() && request.auth.uid == uid && request.resource.data.status == "pending" && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && request.auth.uid == uid && resource.data.status != "blocked" && request.resource.data.status == resource.data.status;
      allow create, update: if isAfMentor();
      allow delete: if false;
    }
    match /afTools/{uid}/{document=**} {
      allow read, write: if hasAfAccess(uid);
      allow read, write: if isAfMentor();
    }
    match /afMenteeNotes/{uid}/{document=**} {
      allow read, write: if hasAfAccess(uid);
      allow read: if isAfMentor();
    }
    match /afMentorNotes/{document=**} {
      allow read, write: if isAfMentor();
    }
    match /afMentorScripts/{document=**} {
      allow read, write: if isAfMentor();
    }
    match /afCalls/{callId} {
      allow read: if isSignedIn() && (isAfMentor() || resource.data.mentorId == request.auth.uid || resource.data.menteeId == request.auth.uid);
      allow create: if isAfMentor();
      allow update, delete: if isAfMentor();
      match /signals/{signalId} {
        function isCallParticipant() {
          let call = get(/databases/$(database)/documents/afCalls/$(callId));
          return request.auth != null && (isAfMentor() || call.data.mentorId == request.auth.uid || call.data.menteeId == request.auth.uid);
        }
        allow read, create, delete: if isCallParticipant();
        allow update: if false;
      }
      match /participants/{uid} {
        function isCallParticipant() {
          let call = get(/databases/$(database)/documents/afCalls/$(callId));
          return request.auth != null && (isAfMentor() || call.data.mentorId == request.auth.uid || call.data.menteeId == request.auth.uid);
        }
        allow read: if isCallParticipant();
        allow create, update, delete: if isCallParticipant() && request.auth.uid == uid;
      }
    }
    match /afPresence/{uid} {
      allow read: if isSignedIn() && (isAfMentor() || hasAfAccess(request.auth.uid));
      allow create, update: if isSignedIn() && request.auth.uid == uid && (isAfMentor() || hasAfAccess(request.auth.uid));
      allow delete: if isSignedIn() && (request.auth.uid == uid || isAfMentor());
    }
    match /afRooms/{roomId} {
      allow read: if isSignedIn() && (isAfMentor() || hasAfAccess(request.auth.uid));
      allow create, update, delete: if isAfMentor();
    }
    match /taAccess/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAfMentor());
      allow create, update: if isAfMentor();
      allow delete: if false;
    }
    match /taAccessRequests/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAfMentor());
      allow create: if isSignedIn() && request.auth.uid == uid && request.resource.data.uid == request.auth.uid && request.resource.data.status == "pending";
      allow update: if isAfMentor();
      allow delete: if false;
    }
    match /taComercial/{uid} {
      allow read, write: if isAfMentor();
    }
    match /taTools/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
      allow read: if isAfMentor();
    }
    match /visionStudioProjects/{uid}/projects/{projectId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid && request.resource.data.ownerUid == uid;
      allow update: if request.auth != null && request.auth.uid == uid && resource.data.ownerUid == uid && request.resource.data.ownerUid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid && resource.data.ownerUid == uid;
      match /references/{referenceId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid && request.resource.data.ownerUid == uid;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }
    match /visionStudioUsers/{uid}/catalogs/{catalogId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid;
    }
    match /visionStudioProjects/{uid}/settings/{settingId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid && request.resource.data.ownerUid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    function isIsaacSuperAdmin() {
      return request.auth != null && request.auth.token.email in ["yanfili.simon@gmail.com", "srklehn@gmail.com"];
    }
    function isIsaacOperator() {
      return request.auth != null && (isIsaacSuperAdmin() || (exists(/databases/$(database)/documents/isaacAccess/$(request.auth.token.email)) && get(/databases/$(database)/documents/isaacAccess/$(request.auth.token.email)).data.active == true));
    }
    match /isaacAccess/{emailId} {
      allow read: if isIsaacSuperAdmin() || (isSignedIn() && request.auth.token.email == emailId);
      allow create, delete: if isIsaacSuperAdmin();
      allow update: if isIsaacSuperAdmin() || (isSignedIn() && request.auth.token.email == emailId && resource.data.active == true && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'name', 'lastLoginAt']));
    }
    match /isaacInstitutions/{id} {
      allow read, create, update: if isIsaacOperator();
      allow delete: if isIsaacSuperAdmin();
    }
    match /isaacReferrals/{id} {
      allow read, create, update: if isIsaacOperator();
      allow delete: if isIsaacSuperAdmin();
    }
    function isLegadoCeo() {
      return request.auth != null && (request.auth.uid == "1GO7dRdFUFg2NwYwzOwjvtWfpAS2" || request.auth.token.email in ["yanfili.simon@gmail.com", "plmacramo@gmail.com", "sendatantrica@gmail.com", "opatricksimon@gmail.com"]);
    }
    match /legado_users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isLegadoCeo());
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && (request.auth.uid == uid || isLegadoCeo());
      allow delete: if false;
    }
    match /legado_access/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isLegadoCeo());
      allow create, update: if isLegadoCeo();
      allow delete: if false;
    }
    match /legado_profiles/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if isLegadoCeo();
    }
    match /legado_points/{id} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isLegadoCeo());
      allow create: if request.auth != null && (request.resource.data.userId == request.auth.uid || isLegadoCeo());
      allow update, delete: if isLegadoCeo();
    }
    match /legado_logs/{id} {
      allow read: if isLegadoCeo();
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
    match /legado_events/{id} {
      allow read: if request.auth != null;
      allow write: if isLegadoCeo();
    }
    match /legado_invites/{email} {
      allow read: if request.auth != null && (request.auth.token.email == email || isLegadoCeo());
      allow create, update: if isLegadoCeo();
      allow delete: if false;
    }
    // ============================================
    // FASE 01 — ARQUITETURA DE ESSÊNCIA
    // Apps independentes. Isolamento por UID.
    // ============================================
    match /afEssencia/{uid} {
      allow read: if isAfMentor() || hasAfAccess(uid);
      allow create, update, delete: if hasAfAccess(uid);
      match /{document=**} {
        allow read: if isAfMentor() || hasAfAccess(uid);
        allow create, update, delete: if hasAfAccess(uid);
      }
    }
    match /afMarketingPessoal/{uid} {
      allow read: if isAfMentor() || hasAfAccess(uid);
      allow create, update, delete: if hasAfAccess(uid);
      match /{document=**} {
        allow read: if isAfMentor() || hasAfAccess(uid);
        allow create, update, delete: if hasAfAccess(uid);
      }
    }
    match /afBrandingPessoal/{uid} {
      allow read: if isAfMentor() || hasAfAccess(uid);
      allow create, update, delete: if hasAfAccess(uid);
      match /{document=**} {
        allow read: if isAfMentor() || hasAfAccess(uid);
        allow create, update, delete: if hasAfAccess(uid);
      }
    }
    match /afLideranca/{uid} {
      allow read: if isAfMentor() || hasAfAccess(uid);
      allow create, update, delete: if hasAfAccess(uid);
      match /{document=**} {
        allow read: if isAfMentor() || hasAfAccess(uid);
        allow create, update, delete: if hasAfAccess(uid);
      }
    }
    match /afComunicacao/{uid} {
      allow read: if isAfMentor() || hasAfAccess(uid);
      allow create, update, delete: if hasAfAccess(uid);
      match /{document=**} {
        allow read: if isAfMentor() || hasAfAccess(uid);
        allow create, update, delete: if hasAfAccess(uid);
      }
    }
    match /afIdentityStudio/{uid} {
      allow read: if isAfMentor() || hasAfAccess(uid);
      allow create, update, delete: if hasAfAccess(uid);
      match /{document=**} {
        allow read: if isAfMentor() || hasAfAccess(uid);
        allow create, update, delete: if hasAfAccess(uid);
      }
    }
    match /afConstelacaoFamiliar/{uid} {
