    match /afIndicadoresFinanceiros/{uid} {
      allow read: if isAfMentor() || hasLegacyPhaseAccess(uid, "phase03");
      allow create, update, delete: if hasLegacyPhaseAccess(uid, "phase03");
      match /{document=**} {
        allow read: if isAfMentor() || hasLegacyPhaseAccess(uid, "phase03");
        allow create, update, delete: if hasLegacyPhaseAccess(uid, "phase03");
      }
    
    // CENTRAL DE ROTEIROS — equipe autorizada, sem Firebase Storage.
    function isScriptHubMember() {
      return request.auth != null && request.auth.token.email != null
        && exists(/databases/$(database)/documents/scriptHubMembers/$(request.auth.token.email))
        && get(/databases/$(database)/documents/scriptHubMembers/$(request.auth.token.email)).data.active == true;
    }
    function canEditScriptHub() {
      return isAfMentor() || (isScriptHubMember()
        && get(/databases/$(database)/documents/scriptHubMembers/$(request.auth.token.email)).data.role == 'editor');
    }
    // FASE 3 / 4 / 5 — EXPANSÃO, ESTRUTURA E CONTINUIDADE
    // Mesmo controle de acesso AF; proprietário aprovado opera os próprios dados.
    match /afMetasFinanceiras/{uid} {
      allow read: if isAfMentor() || hasLegacyPhaseAccess(uid, "phase03");
      allow create, update, delete: if hasLegacyPhaseAccess(uid, "phase03");
      match /{document=**} {
        allow read: if isAfMentor() || hasLegacyPhaseAccess(uid, "phase03");
        allow create, update, delete: if hasLegacyPhaseAccess(uid, "phase03");
