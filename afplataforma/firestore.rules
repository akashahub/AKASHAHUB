    match /afLegadoSemFundador/{uid} {
      allow read: if isAfMentor() || hasLegacyPhaseAccess(uid, "phase05");
      allow create, update, delete: if hasLegacyPhaseAccess(uid, "phase05");
      match /{document=**} {
        allow read: if isAfMentor() || hasLegacyPhaseAccess(uid, "phase05");
        allow create, update, delete: if hasLegacyPhaseAccess(uid, "phase05");
      }
    

    match /scriptHubMembers/{email} {
      allow read: if isAfMentor() || (request.auth != null && request.auth.token.email == email);
      allow create, update, delete: if isAfMentor();
    }

    // CONTEXTO DO PROJETO — Biblioteca de Prompts
    // Documento principal por UID; estrutura pronta para projetos adicionais.
    match /afProjectContexts/{uid}/projects/{projectId} {
      allow read: if canAccessProjectContext(uid);
      allow create, update: if canAccessProjectContext(uid)
        && request.resource.data.keys().hasOnly(["ownerUid", "context", "schemaVersion", "updatedBy", "updatedAt"])
        && request.resource.data.ownerUid == uid
        && request.resource.data.context is map
        && validProjectContextMap(request.resource.data.context)
        && request.resource.data.schemaVersion == 1
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /scriptHubContent/{scriptId} {
      allow read: if isAfMentor() || isScriptHubMember();
      allow create, update: if canEditScriptHub()
        && request.resource.data.title is string && request.resource.data.title.size() <= 180
        && request.resource.data.body is string && request.resource.data.body.size() <= 250000;
      allow delete: if isAfMentor();
    }
    // LEITURACALL — registros oficiais privados do mentor.
    // Clientes não leem nem alteram esta coleção; a área do cliente será habilitada em etapa própria.
    match /leituracallRecords/{recordId} {
      allow read, create, update, delete: if isAfMentor();
    }

    // CENTRAL DE LINKS — biblioteca privada, exclusiva para identidades de mentor.
    // Os dados não são públicos; a autorização é reforçada pelas regras do Firestore.
    match /centralLinks/{linkId} {
      allow read, create, update, delete: if isAfMentor();
    }
    // SALA DE MENTORIA AL — roteiros, mapas e materiais privados do mentor.
    // Somente identidades de mentor podem ler ou gravar; versões antigas ficam em subcoleção.
    match /alMentoriaScripts/{libraryId} {
      allow read, create, update: if isAfMentor();
      allow delete: if false;
      match /versions/{versionId} {
        allow read, create: if isAfMentor();
        allow update, delete: if false;
      }
    }

    // ============================================
    // GERADOR DE PROPOSTAS — CENTRAL DO EXPERT
    // Histórico privado de propostas comerciais.
    // Somente mentores autorizados podem acessar.
    // ============================================
    match /alCommercialProposals/{proposalId} {
      allow read, create, update, delete: if isAfMentor();
    }


    // AKASHA LOCAL INTELLIGENCE — CRM, territórios, lotes, demonstrações e financeiro.
    // Acesso restrito à equipe mentor autorizada; nenhuma coleção é pública.
    match /alLocalBusinesses/{businessId} {
      allow read, create, update: if isAfMentor();
      allow delete: if false;
    }
    match /alLocalTerritories/{territoryId} {
      allow read, create, update: if isAfMentor();
      allow delete: if false;
    }
    match /alLocalBatches/{batchId} {
      allow read, create, update: if isAfMentor();
      allow delete: if false;
    }
    match /alLocalDemos/{demoId} {
      allow read, create, update: if isAfMentor();
      allow delete: if false;
    }
    match /alLocalProposals/{proposalId} {
      allow read, create, update: if isAfMentor();
      allow delete: if false;
    }
    match /alLocalFinance/{entryId} {
      allow read, create, update: if isAfMentor();
      allow delete: if false;
    }

