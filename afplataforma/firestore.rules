    match /scriptHubMembers/{email} {
      allow read: if isAfMentor() || (request.auth != null && request.auth.token.email == email);
      allow create, update, delete: if isAfMentor();
    }

    // CONTEXTO DO PROJETO — Biblioteca de Prompts
    // Documento principal por UID; estrutura pronta para projetos adicionais.
    match /afProjectContexts/{uid}/projects/{projectId} {
      allow read: if canAccessProjectContext(uid);
      allow create, update: if canAccessProjectContext(uid)
        && request.resource.data.keys().hasOnly(["ownerUid", "context", "schemaVersion", "updatedBy", "updatedAt"])
        && request.resource.data.ownerUid == uid
        && request.resource.data.context is map
        && validProjectContextMap(request.resource.data.context)
        && request.resource.data.schemaVersion == 1
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /scriptHubContent/{scriptId} {
      allow read: if isAfMentor() || isScriptHubMember();
      allow create, update: if canEditScriptHub()
        && request.resource.data.title is string && request.resource.data.title.size() <= 180
        && request.resource.data.body is string && request.resource.data.body.size() <= 250000;
      allow delete: if isAfMentor();
    }
  }
