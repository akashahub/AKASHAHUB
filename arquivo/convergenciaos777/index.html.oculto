<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
<meta name="theme-color" content="#0B0B0F"/>
<meta name="robots" content="noindex,nofollow"/>
<title>Convergência OS</title>
<link rel="canonical" href="https://akashahub.com.br/convergenciaos777/"/>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,560&family=Sora:wght@400;600&display=swap" rel="stylesheet"/>
<style>
:root{--bg:#0b0b0f;--bg2:#14141b;--ink:#f4ede0;--dim:#b7ae9f;--mute:#7d766b;--gold:#d4af6a;--ok:#7dcea0;--line:rgba(244,237,224,.1);--hot:#e07a72}
*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);font-family:Sora,system-ui,sans-serif}
body{min-height:100dvh}
button,input,select{font:inherit;color:inherit}button{cursor:pointer}
.wrap{max-width:520px;margin:0 auto;padding:0 0 84px}
.brand{color:var(--gold);letter-spacing:.14em;text-transform:uppercase;font-family:Fraunces,serif;font-size:13px}
h1,h3{font-family:Fraunces,serif;margin:0;font-weight:560}h1{font-size:30px;line-height:1.05}h3{font-size:18px}
.k{color:var(--gold);letter-spacing:.14em;text-transform:uppercase;font-size:11px;margin:0 0 8px}
.q{color:var(--dim);font-size:14px;line-height:1.5}.m{color:var(--mute);font-size:12px}
.card{background:#14141b;border:1px solid var(--line);border-radius:18px;padding:16px;margin-top:12px;width:100%;text-align:left}
button.card{display:block}
.row{display:flex;justify-content:space-between;align-items:center;gap:10px}
.mark{width:42px;height:42px;border-radius:14px;display:grid;place-items:center;background:#241c10;color:var(--gold);font-size:20px;flex:none}
.btn{width:100%;border:0;border-radius:999px;padding:13px 16px;background:var(--gold);color:#1a1408;font-weight:600;margin-top:12px}
.btn2{background:transparent;color:var(--ink);border:1px solid var(--line)}
.btn3{background:#2a2010;color:var(--gold)}
.inline{width:auto;margin:0;padding:8px 12px;font-size:12px}
input,select{width:100%;background:#0e0e14;border:1px solid var(--line);border-radius:14px;padding:12px;margin-top:6px}
.pill{display:inline-flex;gap:6px;align-items:center;background:#1c1c26;border-radius:999px;padding:4px 8px;font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:var(--dim)}
.hot{background:#3a1818;color:#f0b2ac}.ok{background:#16301f;color:var(--ok)}
.dot{width:7px;height:7px;border-radius:50%;background:var(--hot);display:inline-block}
.top{position:sticky;top:0;z-index:15;display:flex;align-items:center;justify-content:space-between;padding:12px 14px;background:rgba(11,11,15,.92);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
.top b{font-family:Fraunces,serif;font-weight:560;letter-spacing:.02em;font-size:22px}
.top .icons{display:flex;gap:14px}
.top button,.nav button,.iconbtn{background:0;border:0;color:var(--ink);padding:0}
.stories{display:flex;gap:14px;overflow:auto;padding:12px 14px 8px;border-bottom:1px solid var(--line)}
.stories::-webkit-scrollbar{display:none}
.story{width:68px;flex:none;background:0;border:0;color:inherit;text-align:center;padding:0}
.ring{width:62px;height:62px;border-radius:50%;padding:2px;background:conic-gradient(from 200deg,#e07a72,#d4af6a,#f4ede0,#e07a72);display:grid;place-items:center}
.ring i{width:54px;height:54px;border-radius:50%;background:#0b0b0f;display:grid;place-items:center;font-size:20px;border:2px solid #0b0b0f}
.story small{display:block;margin-top:6px;font-size:11px;color:var(--dim);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.post{border-bottom:1px solid var(--line);padding-bottom:12px}
.post-h{display:flex;gap:10px;align-items:center;padding:10px 12px}
.post-h button{background:0;border:0;color:inherit;padding:0;text-align:left}
.media{position:relative;margin:0 0 8px;aspect-ratio:4/5;background:radial-gradient(420px 220px at 50% 60%,rgba(212,175,106,.2),transparent 62%),#101016;display:flex;align-items:center;justify-content:center;width:100%;border:0;color:inherit}
.media .mark{font-size:54px;width:96px;height:96px;border-radius:28px}
.media .pill{position:absolute;left:12px;bottom:12px}
.pad{padding:16px 16px 0}
.iconbtn svg{width:26px;height:26px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linejoin:round;stroke-linecap:round}
.actions .sp{margin-left:auto}
.caption{padding:8px 12px 0;font-size:14px}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2px;margin-top:12px}
.grid button{aspect-ratio:1;border:0;background:#14141b;color:var(--gold);font-size:28px}
.reel{min-height:calc(100dvh - 64px);display:flex;flex-direction:column;justify-content:flex-end;padding:18px 16px 24px;background:radial-gradient(500px 240px at 50% 70%,rgba(212,175,106,.2),transparent 55%),#07070b}
.nav{position:fixed;left:50%;bottom:0;transform:translateX(-50%);width:min(520px,100%);display:grid;grid-template-columns:repeat(5,1fr);background:#0b0b0f;border-top:1px solid var(--line);padding:8px 0 calc(8px + env(safe-area-inset-bottom));z-index:20}
.nav button{background:0;border:0;color:var(--mute);padding:6px 0;display:grid;place-items:center}
.nav button.on{color:var(--ink)}
.nav svg{width:26px;height:26px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linejoin:round;stroke-linecap:round}
.nav .me{width:26px;height:26px;border-radius:50%;display:grid;place-items:center;border:1.5px solid currentColor;font-size:11px}
.toast{position:fixed;top:14px;left:50%;transform:translateX(-50%);background:#1d1912;border:1px solid #d4af6a66;color:#f0d59a;padding:10px 14px;border-radius:999px;z-index:40;max-width:calc(100% - 24px);font-size:13px}
.gate{min-height:100dvh;display:flex;flex-direction:column;justify-content:center;padding:28px 20px;max-width:520px;margin:0 auto}
.stage video{width:100%;border-radius:16px;background:#000;aspect-ratio:16/9;object-fit:cover;margin-top:10px}
.tiles{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}
.filters{display:flex;gap:8px;overflow:auto;padding:10px 14px 0}
.filters::-webkit-scrollbar{display:none}
.filters button{border:1px solid var(--line);background:transparent;border-radius:999px;padding:7px 11px;color:var(--dim);font-size:12px;white-space:nowrap}
.filters button.on{background:var(--gold);color:#1a1408;border-color:transparent}
.livebar{width:100%;display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:14px;background:#1a1212;border:1px solid rgba(224,122,114,.45);border-radius:14px;padding:12px;color:inherit;text-align:left}
.chat{margin-top:14px}
.chatlog{max-height:160px;overflow:auto;display:grid;gap:6px;margin:8px 0}
.grid button small{display:block;font-size:10px;color:var(--dim);letter-spacing:.04em;text-transform:uppercase}
.gastro{background:#10241c;border-color:rgba(157,204,178,.45)}
.gastro h3,.gastro .mark{color:#9dccb2}
.ad{margin:12px 14px 0;background:#1a160f}
</style>
</head>
<body>
<div id="app"></div>
<script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-auth-compat.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.49.1/dist/umd/supabase.js"></script>
<script src="https://cdn.jsdelivr.net/npm/livekit-client@2.15.7/dist/livekit-client.umd.js"></script>
<script src="app.js?v=20260926b"></script>
</body>
</html>
